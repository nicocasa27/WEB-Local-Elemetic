# Plantilla de variables de entorno. Copiar como .env y rellenar.
# El archivo .env NO se versiona (está en .gitignore).

# Entorno: dev (por defecto) o prod.
DJANGO_ENV=prod

# Clave de firma de sesiones y tokens. Obligatoria con DJANGO_ENV=prod.
# Generar una nueva con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=

# Hosts desde los que se puede servir la aplicación, separados por comas.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,192.168.50.92

# Origenes de confianza para los formularios (CSRF), con esquema y puerto.
DJANGO_CSRF_TRUSTED_ORIGINS=http://192.168.50.92:8501,http://localhost:8501

# PostgreSQL con los datos de negocio. La contraseña es obligatoria en prod.
MES_DB_NAME=mes_vigas
MES_DB_USER=postgres
MES_DB_PASSWORD=
MES_DB_HOST=127.0.0.1
MES_DB_PORT=5432

# Poner en 1 sólo cuando haya un proxy con certificado TLS delante.
# Activarlo sin HTTPS deja a todo el mundo fuera del sistema.
DJANGO_HTTPS=0

# Parámetros de negocio.
TON_POR_PERSONA_META=1.00
WEEKLY_SNAPSHOT_RETENTION_WEEKS=156
