# Plantilla de variables de entorno. Copiar como .env y rellenar.
# El archivo .env NO se versiona (está en .gitignore).

# Entorno: dev (por defecto) o prod.
DJANGO_ENV=prod

# Clave de firma de sesiones y tokens. Obligatoria con DJANGO_ENV=prod.
# Generar una nueva con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=

# Hosts desde los que se puede servir la aplicación, separados por comas.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,192.168.50.92

# Origenes de confianza para los formularios (CSRF), con esquema y puerto.
DJANGO_CSRF_TRUSTED_ORIGINS=http://192.168.50.92:8501,http://localhost:8501

# PostgreSQL con los datos de negocio. La contraseña es obligatoria en prod.
MES_DB_NAME=mes_vigas
MES_DB_USER=postgres
MES_DB_PASSWORD=
MES_DB_HOST=127.0.0.1
MES_DB_PORT=5432

# Poner en 1 sólo cuando haya un proxy con certificado TLS delante.
# Activarlo sin HTTPS deja a todo el mundo fuera del sistema.
DJANGO_HTTPS=0

# Parámetros de negocio.
TON_POR_PERSONA_META=1.00
WEEKLY_SNAPSHOT_RETENTION_WEEKS=156

# ---------------------------------------------------------------- núcleo
#
# Migración al motor unificado, una línea a la vez. Tres valores:
#
#   apagada  el núcleo existe y nadie lo usa. Es lo que hay si no se pone
#            nada, y es lo que había antes de esta versión.
#   doble    las pantallas siguen escribiendo en las tablas de siempre y
#            además, en la misma transacción, en el núcleo. La verdad sigue
#            estando en lo de siempre. `reconciliar_nucleo` compara las dos
#            todos los días.
#   corte    el núcleo pasa a ser la fuente de verdad.
#
# Pasar a «corte» sólo cuando la reconciliación lleve **siete días seguidos
# sin encontrar nada**, y de una línea a la vez, de menos a más riesgo:
# robótica → corta → herrería → vigas. Se deshace poniendo «doble» otra vez
# y reiniciando; no hay que tocar la base.
#
# Antes de encender «doble» por primera vez hay que haber corrido, en este
# orden: sembrar_nucleo, backfill_nucleo, verificar_backfill.
MES_NUCLEO_ROBOTICA=doble
MES_NUCLEO_CORTA=doble
MES_NUCLEO_HERRERIA=doble
MES_NUCLEO_VIGAS=doble

# Durante el rodaje, un fallo al escribir en el núcleo se anota en el registro
# y la operación continúa: lo contrario es que un operador no pueda apuntar su
# trabajo por culpa de una tabla que todavía no manda nada. Poner en 1 cuando
# se haya comprobado, mirando el registro, que no salta nunca.
MES_NUCLEO_ESTRICTO=0

# ---------------------------------------------------------------- la tableta
#
# Minutos sin tocar nada antes de que se cierre sola la sesión abierta con un
# PIN desde la tableta del piso. Quince si no se pone nada.
#
# La tableta es de todos: una sesión que se queda abierta hace que el trabajo
# del siguiente se registre a nombre del anterior, y ese es justo el dato con
# el que se mide el rendimiento. Subirlo mucho lo estropea; bajarlo mucho
# obliga a teclear el PIN cada dos piezas.
#
# **Sólo afecta a las sesiones de PIN.** Las de oficina, abiertas con usuario y
# contraseña, no se cierran solas.
MES_PIN_MINUTOS=15
